# Strip cell outputs and metadata from Jupyter notebooks before they are staged for commit.
# Reason: reduces committed file size and thus prevents having to use LFS.
# Requires installation per repo:
#   - pip install nbstripout
#   - in the repo containing the .git folder: nbstripout --install
*.ipynb filter=nbstripout

# Exclude report.html and plots from GitHub language statistics.
projects/**/report.html linguist-generated=true
projects/**/plots/** linguist-generated=true